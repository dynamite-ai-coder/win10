# ===========================================================================
# Windows 10 VM on Render - environment configuration
# ===========================================================================
# Copy to `.env` for local runs, or set these variables in the Render
# Dashboard (Environment tab) / via the Render API / render.yaml.
#
# NEVER commit real secrets. NGROK_AUTHTOKEN and STATUS_API_TOKEN are
# secrets and must be supplied through the platform secret store.
# ===========================================================================

# ---------------------------------------------------------------------------
# Service / status API
# ---------------------------------------------------------------------------
PORT=10000
DEBUG_MODE=false
STATUS_API_TOKEN=
STATUS_API_ALLOW_UNAUTH=false
STATUS_API_BIND=0.0.0.0

# ---------------------------------------------------------------------------
# KVM / acceleration
# ---------------------------------------------------------------------------
# KVM_REQUIRED=true      -> refuse to boot Windows when /dev/kvm is unusable
# ENABLE_TCG_FALLBACK    -> explicit opt-in to slow software emulation
# KVM_TEST_ONLY=true     -> run diagnostics only, never boot the VM
# VM_AUTOSTART=true      -> boot the VM at container start
KVM_REQUIRED=true
ENABLE_TCG_FALLBACK=false
KVM_TEST_ONLY=false
VM_AUTOSTART=false

# ---------------------------------------------------------------------------
# Virtual machine resources
# ---------------------------------------------------------------------------
# On Render 8c-32g leave headroom for Docker/QEMU/ngrok/status server.
VM_MEMORY_MB=22528
VM_CPUS=6
VM_NAME=windows10
VM_MACHINE=q35
VM_CPU_MODEL=host
VM_CPU_MODEL_TCG=max

# ---------------------------------------------------------------------------
# Persistent disk (must live on the Render persistent disk)
# Mount path in Render: /var/lib/windows
# ---------------------------------------------------------------------------
VM_DATA_DIR=/var/lib/windows
VM_DISK=/var/lib/windows/windows10.qcow2
VM_DISK_SIZE_GB=120
VM_DISK_AUTOCREATE=true
VM_DISK_BUS=virtio
VM_DISK_CACHE=writeback

# ---------------------------------------------------------------------------
# Installation media (administrator supplied; never commit/distribute)
# ---------------------------------------------------------------------------
WINDOWS_ISO=/var/lib/windows/iso/windows10.iso
WINDOWS_ISO_URL=
VIRTIO_ISO=/var/lib/windows/iso/virtio-win.iso
VIRTIO_ISO_URL=
VM_BOOT_DEVICE=auto
VM_INSTALL_MARKER=/var/lib/windows/state/windows_installed
ISO_DOWNLOAD_TIMEOUT=1800

# ---------------------------------------------------------------------------
# UEFI / OVMF firmware
# ---------------------------------------------------------------------------
OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
OVMF_VARS_TEMPLATE=/usr/share/OVMF/OVMF_VARS_4M.fd
OVMF_VARS=/var/lib/windows/uefi/OVMF_VARS.fd

# ---------------------------------------------------------------------------
# Networking (RDP is bound to 127.0.0.1 only and reached through ngrok)
# ---------------------------------------------------------------------------
VM_HOSTFWD_RDP=3389
VM_MAC=

# ---------------------------------------------------------------------------
# Display / input
# ---------------------------------------------------------------------------
VM_VGA=std
VM_DISPLAY=none
VM_USB_TABLET=true

# ---------------------------------------------------------------------------
# Lifecycle / timeouts
# ---------------------------------------------------------------------------
VM_STATE_DIR=/run/windows-vm
VM_LOG_DIR=/var/log/windows-vm
VM_START_TIMEOUT=180
VM_SHUTDOWN_TIMEOUT=180
VM_MONITOR_TIMEOUT=10

# ---------------------------------------------------------------------------
# ngrok tunnel
# ---------------------------------------------------------------------------
# NGROK_TUNNELS is a comma separated list: rdp, api
#   rdp -> secure TCP tunnel to 127.0.0.1:3389 (RDP)
#   api -> HTTPS tunnel to the status server (token protected)
NGROK_ENABLED=false
NGROK_REQUIRED=false
NGROK_AUTHTOKEN=
NGROK_TUNNELS=rdp
NGROK_RDP_ADDR=3389
NGROK_API_ADDR=10000
NGROK_START_TIMEOUT=45
